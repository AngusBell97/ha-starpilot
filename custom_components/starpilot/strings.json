  "services": {
    "navigate": {
      "name": "Set destination",
      "description": "Sends a destination to the comma's navigation. Give either a search or a latitude and longitude.",
      "fields": {
        "config_entry_id": {
          "name": "comma",
          "description": "Which comma to send it to. Only needed when more than one is set up."
        },
        "query": {
          "name": "Search",
          "description": "A place or address to search for. The first result is used. Needs a map key on the comma."
        },
        "name": {
          "name": "Name",
          "description": "The name to show for a latitude and longitude."
        },
        "address": {
          "name": "Address",
          "description": "An address line to show under the name."
        },
        "latitude": {
          "name": "Latitude",
          "description": "Latitude of the destination."
        },
        "longitude": {
          "name": "Longitude",
          "description": "Longitude of the destination."
        }
      }
    }
  },
  "exceptions": {
    "action_failed": {
      "message": "The comma did not accept that: {error}"
    },
    "no_device": {
      "message": "No comma is connected right now."
    },
    "choose_device": {
      "message": "More than one comma is set up. Choose which one to use."
    },
    "destination_required": {
      "message": "Give either a search, or a latitude and longitude."
    },
    "no_search_result": {
      "message": "The comma found nothing for \"{query}\"."
    }
  }

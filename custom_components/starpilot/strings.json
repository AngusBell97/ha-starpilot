{
  "config": {
    "step": {
      "user": {
        "title": "Connect to StarPilot",
        "description": "Enter the address Galaxy shows for your comma on your home network. Give the comma a fixed address in your router so it does not change.",
        "data": {
          "host": "Address",
          "port": "Port"
        },
        "data_description": {
          "host": "The comma's IP address, for example 192.168.1.50.",
          "port": "Galaxy uses 8082 unless you changed it."
        }
      },
      "reconfigure": {
        "title": "Change the comma's address",
        "data": {
          "host": "Address",
          "port": "Port"
        },
        "data_description": {
          "host": "The comma's IP address, for example 192.168.1.50.",
          "port": "Galaxy uses 8082 unless you changed it."
        }
      }
    },
    "error": {
      "cannot_connect": "Galaxy did not answer at that address. Check that the comma is on and on the same network.",
      "not_local": "Galaxy refused the connection. It only allows devices on the same local network, reached by IP address and without a proxy in between.",
      "unknown": "Something unexpected went wrong. Check the Home Assistant log."
    },
    "abort": {
      "already_configured": "This comma is already set up.",
      "reconfigure_successful": "The address was changed.",
      "wrong_device": "A different comma answered at that address."
    }
  },
